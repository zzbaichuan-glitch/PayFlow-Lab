# Development-only credentials for the local Docker lab.
# Copy this file to .env. Do not reuse these values outside local learning.
MYSQL_ROOT_PASSWORD=payflow_root_dev
MYSQL_DATABASE=payflow
MYSQL_USER=payflow
MYSQL_PASSWORD=payflow_dev
REDIS_PASSWORD=payflow_redis_dev

# Optional localhost debug ports. The participant services stay internal.
PAYFLOW_MYSQL_PORT=3307
PAYFLOW_REDIS_PORT=6380
PAYFLOW_DTM_PORT=36789
PAYFLOW_HTTP_PORT=8081
